[package]
name = "rqs-harness"
version = "0.1.0"
edition = "2021"

[dependencies]
rqs_lib = { path = "RQS_CORE_LIB", default-features = false }
tokio = { version = "1", features = ["macros", "rt-multi-thread", "time"] }
anyhow = "1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
